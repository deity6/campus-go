#include <windows.h>

/* 源文件是 UTF-8，告诉 windres 按 65001 解析，否则中文会变乱码 */
#pragma code_page(65001)

/* 应用图标：资源 ID 1，与 winapp 里 LoadImageW(1) 对应 */
1 ICON "app.ico"

/* 版本信息 —— 在资源管理器「属性 → 详细信息」里能看到 */
1 VERSIONINFO
FILEVERSION     4,3,2,0
PRODUCTVERSION  4,3,2,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName",      "CampusAutoLogin Contributors"
            VALUE "FileDescription",  "校园网自动认证"
            VALUE "FileVersion",      "4.3.2.0"
            VALUE "InternalName",     "CampusAutoLogin"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "CampusAutoLogin.exe"
            VALUE "ProductName",      "校园网自动认证"
            VALUE "ProductVersion",   "4.3.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END

/* 清单：DPI 感知、通用控件 v6、long path */
1 24 "app.manifest"
